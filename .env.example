# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Model (provider-qualified). pydantic-ai supports openai:, anthropic:, etc.
MODEL_NAME=openai:gpt-4o-mini

# Local Langfuse OTLP endpoint (self-hosted observability — no Logfire).
OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
# Keys from the Landon-Hermes project in Langfuse. Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
