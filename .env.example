# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Persistence store root (a directory of flat files). Relative to repo root;
# defaults to data/paf/. Optional — unset for the default.
# PERSISTENCE_DIR=data/paf

# Local Langfuse OTLP endpoint (self-hosted observability — no Logfire).
OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
# Keys from the Langfuse project paf traces belong in. Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY

# OpenAI — required for the default model (openai:gpt-6-luna).
# Create at https://platform.openai.com/api-keys. pydantic-ai reads OPENAI_API_KEY automatically.
OPENAI_API_KEY

# OpenRouter — optional, for alternative models (e.g. deepseek via openrouter: prefix).
# Create at https://openrouter.ai/keys.
# OPENROUTER_API_KEY

# Web Push (PWA notifications) — optional; unset = push disabled (the /api/push/*
# routes return 503 and the agent's send_push tool reports it isn't configured).
# Generate the keypair ONCE and append it to .env:
#   .venv/bin/python scripts/gen_vapid.py --write
# Never rotate it afterwards: every device's push subscription is bound to the
# public key, so a new keypair silently drops all subscribed devices.
# PAF_VAPID_PRIVATE_KEY=
# PAF_VAPID_PUBLIC_KEY=
# PAF_VAPID_SUBJECT=mailto:you@example.com

# Optional: Tavily for web search/extract. Without it the Web capability uses
# keyless DuckDuckGo search and an SSRF-protected local page fetch.
# TAVILY_API_KEY=

# Optional: extra CORS origins for paf-ui, comma-separated (for example an HTTPS
# proxy in front of it). localhost:3000 and :3001 are always allowed.
# PAF_EXTRA_ORIGINS=

# Langfuse stack (deploy/langfuse.yaml): encryption key for the self-hosted instance.
# Generate with `openssl rand -hex 32`. Changing it makes stored secrets unreadable.
# LANGFUSE_ENCRYPTION_KEY=
