# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Hermes workspace-local plans (plan skill output). Plans are preserved in the
# Obsidian vault (Portfolio-GitHub/History/), not in the public repo.
.hermes/

# Persistence store — runtime state, not source. Historically a sqlite db;
# now the harness FileStepStore writes a directory of JSON/JSONL under
# data/paf/. Ignore the runtime tree. `data/*` (not `data/`) keeps the root
# traversable so the `!` exceptions can re-include a subtree.
data/*
!.env.example
!data/benchmarks/
data/benchmarks/*
!data/benchmarks/generated/
# Durable seed summaries under generated/ are auto-persisted by run_lmem.py
# (_persist_durable_summary) per seeded question and TRACKED so a fresh clone
# re-runs zero-live-summarizer. They rename only when a question's seed turns
# change. Keep any non-summary churn (e.g. transient run dumps) out via
# explicit ignores below.
data/benchmarks/generated/*
!data/benchmarks/generated/*.jsonl

# Durable per-question memory snapshots under memory/ are auto-persisted by
# run_lmem.py (_persist_durable_memory) per seeded question and TRACKED so a
# fresh clone re-runs with ZERO owner/consolidation tokens (mirrors
# generated/ above). Each <qid>/ holds the owner-produced memory store
# (assistant/MEMORY.md + assistant/.memory-state.json). The two negations below
# simply re-include the memory/ dir that `data/benchmarks/*` would ignore; once
# the dir is included git descends and tracks everything under it. Refresh via
# PAF_FRESH_MEMORY=1 (or LME_QIDS=<qid> PAF_FRESH_MEMORY=1), which re-consolidates
# and overwrites the snapshot.
!data/benchmarks/memory/

# Generated benchmark run outputs (graded runner writes JSON per full run).
tests/results/

# Demo scratch database (ui/cli_demo.py)
demo.db
