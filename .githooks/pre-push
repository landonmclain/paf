#!/usr/bin/env bash
# Pre-push hook: run the same checks as .github/workflows/ci.yml, EXCEPT pyright
# (which we let GitHub CI run — too heavy for every local push).
#
#   ruff check           (lint)
#   ruff format --check  (format)
#   pytest -n auto       (tests)
#
# Any failure prints a banner and exits non-zero, which aborts the push.
# Configure git to use this hooks dir:
#   git config core.hooksPath .githooks
set -u

# Run from the repo root regardless of where the hook was invoked.
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0

step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }

step "ruff check (lint)"
uv run ruff check src tests --output-format=concise || fail=1

step "ruff format --check (format)"
uv run ruff format --check src tests || fail=1

step "pytest -n auto (tests)"
uv run pytest -n auto -q || fail=1

if [ "$fail" -ne 0 ]; then
  printf '\n\033[1;31mpre-push checks FAILED — push aborted.\033[0m\n'
  exit 1
fi

printf '\n\033[1;32mpre-push checks passed.\033[0m\n'
exit 0
