#!/usr/bin/env bash
# Pre-push hook: run the checks most likely to be forgotten, quickly, on every
# push. GitHub CI already runs the full pytest suite, so we don't re-run tests
# here (they're the slow part and rarely forgotten).
#
#   ruff check           (lint)
#   ruff format --check  (format)
#   pyright              (typecheck — the usual silent foot-gun)
#
# Any failure prints a banner and exits non-zero, which aborts the push.
# Configure git to use this hooks dir:
#   git config core.hooksPath .githooks
set -u

# Run from the repo root regardless of where the hook was invoked.
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0

step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }

# Use the venv's ruff directly (AGENTS.md documents `.venv/bin/ruff`), not
# `uv run ruff` — the hook runs in a non-interactive shell where uv may not be
# on PATH. pyright is not in the venv, so it runs via npx.
step "ruff check (lint)"
.venv/bin/ruff check src tests --output-format=concise || fail=1

step "ruff format --check (format)"
.venv/bin/ruff format --check src tests || fail=1

step "pyright (typecheck)"
npx --yes pyright || fail=1

if [ "$fail" -ne 0 ]; then
  printf '\n\033[1;31mpre-push checks FAILED — push aborted.\033[0m\n'
  exit 1
fi

printf '\n\033[1;32mpre-push checks passed.\033[0m\n'
exit 0
